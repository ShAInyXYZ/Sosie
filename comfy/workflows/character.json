{
 "_meta": {
  "title": "Sosie key frame \u2014 Qwen Image 2.1 text-to-image (character in the set)",
  "source": "Settings from GouachePainter's tested Qwen Image 2.1 concept workflow; MultiGPU loaders place it on a free card. API format.",
  "placeholders": "$-strings are filled by server/comfy/template.ts. TextEncodeQwenImage21 makes a square empty latent; LatentUpscale (zeros stay zeros) gives it the key frame's aspect. LatentUpscale assumes 8x latents and Qwen Image 2.1 uses 16x, so $HALF_WIDTH/$HALF_HEIGHT are half the pixel size."
 },
 "1": {
  "class_type": "UNETLoaderMultiGPU",
  "inputs": {
   "unet_name": "$MODEL",
   "weight_dtype": "default",
   "device": "$DEVICE"
  }
 },
 "2": {
  "class_type": "CLIPLoaderMultiGPU",
  "inputs": {
   "clip_name": "$TEXT_ENCODER",
   "type": "qwen_image",
   "device": "$DEVICE"
  }
 },
 "3": {
  "class_type": "VAELoaderMultiGPU",
  "inputs": {
   "vae_name": "$VAE",
   "device": "$DEVICE"
  }
 },
 "4": {
  "class_type": "TextEncodeQwenImage21",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "prompt": "$PROMPT",
   "negative_prompt": "$NEGATIVE",
   "resolution": "$RESOLUTION"
  }
 },
 "5": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "9",
    0
   ],
   "positive": [
    "4",
    0
   ],
   "negative": [
    "4",
    1
   ],
   "latent_image": [
    "8",
    0
   ],
   "seed": "$SEED",
   "steps": "$STEPS",
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "6": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "5",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "7": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "6",
    0
   ],
   "filename_prefix": "$OUT_PREFIX"
  }
 },
 "8": {
  "class_type": "LatentUpscale",
  "inputs": {
   "samples": [
    "4",
    2
   ],
   "upscale_method": "nearest-exact",
   "width": "$HALF_WIDTH",
   "height": "$HALF_HEIGHT",
   "crop": "disabled"
  }
 },
 "9": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "lora_name": "$LORA",
   "strength_model": "$LORA_STRENGTH"
  },
  "_meta": {
   "title": "Qwen Image 2.1 LoRA (dropped when none is picked)"
  }
 }
}
